layout {
    default_tab_template {
        children
        pane size=1 borderless=true {
            plugin location="https://github.com/dj95/zjstatus/releases/latest/download/zjstatus.wasm" {
                format_left "#[fg=yellow,bg=#1d2021] 󱂬 {session}#[bg=#1d2021] {mode}#[bg=#1d2021] {notifications}"
                format_right "{tabs}#[bg=#1d2021] "
                format_space "#[bg=#1d2021]"

                mode_normal        "#[fg=green,bg=#1d2021]  {name}"
                mode_locked        "#[fg=blue,bg=#1d2021]  {name}"
                mode_resize        "#[fg=blue,bg=#1d2021]  {name}"
                mode_pane          "#[fg=blue,bg=#1d2021]  {name}"
                mode_tab           "#[fg=blue,bg=#1d2021]  {name}"
                mode_scroll        "#[fg=blue,bg=#1d2021]  {name}"
                mode_enter_search  "#[fg=blue,bg=#1d2021]  {name}"
                mode_search        "#[fg=blue,bg=#1d2021]  {name}"
                mode_rename_tab    "#[fg=blue,bg=#1d2021]  {name}"
                mode_rename_pane   "#[fg=blue,bg=#1d2021]  {name}"
                mode_session       "#[fg=blue,bg=#1d2021]  {name}"
                mode_move          "#[fg=blue,bg=#1d2021]  {name}"
                mode_prompt        "#[fg=blue,bg=#1d2021]  {name}"
                mode_tmux          "#[fg=blue,bg=#1d2021]  {name}"

                notification_format_unread           "#[fg=cyan,bg=#1d2021]   {message}#[bg=#1d2021] "
                notification_format_no_notifications "#[bg=#1d2021]"
                notification_show_interval           "10"


                tab_normal "#[fg=#7c6f64,bg=#1d2021] {index} "
                tab_active "#[fg=#e2cca9,bold] {index} "
            }
        }
    }
}

command = /opt/homebrew/bin/fish

font-family = JetBrainsMono Nerd Font
font-family = Apple SD Gothic Neo
font-feature = +zero, +ss01, +ss19
font-size = 14
font-thicken = true
font-thicken-strength = 128

adjust-cell-height = 14%
adjust-cell-width = -4%
adjust-font-baseline = -4%

theme = Gruvbox Dark

window-colorspace = display-p3
window-padding-balance = true

cursor-style = block
shell-integration-features = no-cursor

macos-option-as-alt = true
link-url = false

keybind = clear

keybind = cmd+c=copy_to_clipboard
keybind = cmd+v=paste_from_clipboard

keybind = cmd+d=new_split:right
keybind = cmd+shift+d=new_split:down

keybind = cmd+b=scroll_page_fractional:-1.5
keybind = cmd+f=scroll_page_fractional:0.5

keybind = cmd+t=new_tab
keybind = cmd+shift+[=previous_tab
keybind = cmd+shift+]=next_tab
keybind = cmd+1=goto_tab:1
keybind = cmd+2=goto_tab:2
keybind = cmd+3=goto_tab:3
keybind = cmd+4=goto_tab:4

keybind = cmd+h=goto_split:left
keybind = cmd+j=goto_split:down
keybind = cmd+k=goto_split:up
keybind = cmd+l=goto_split:right
